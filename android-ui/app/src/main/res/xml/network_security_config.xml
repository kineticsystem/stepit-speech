<!-- The bridge speaks ws://, on the local network, at an address only we know,
     e.g. 192.168.1.10: a domain list cannot name it, so cleartext is allowed. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
